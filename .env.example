# Chrysty platform
CHRYSTY_API_URL=https://api.chrysty.dev
NEXT_PUBLIC_CHRYSTY_API_URL=https://api.chrysty.dev

# Supabase (chrysty.dev platform project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for API routes — NOT the same as the anon key (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (models TBD — set when benchmarking)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=
OPENAI_MEMORY_MODEL=
OPENAI_OUTFIT_PLAN_MODEL=

# fal.ai (look image rendering)
FAL_KEY=
FAL_IMAGE_MODEL=openai/gpt-image-2/edit
FAL_IMAGE_QUALITY=medium
FAL_OUTPUT_FORMAT=png

# Build-time only (install @chrysty/platform from private monorepo)
GITHUB_TOKEN=

LOOKBOOK_COMPOSITE=true
# Legacy alias — set false to skip post-process and keep raw Fal output
USE_SHARP_COLLAGE_FALLBACK=true
